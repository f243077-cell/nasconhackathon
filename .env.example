# Copy to .env and fill in. NEVER commit .env.
# Per-team HMAC salt printed on the team slip (required; read only from env).
DAY1_SALT=replace-with-salt-from-team-slip

# Everything below has a working default in docker-compose.yml.
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon
POSTGRES_DB=nascon
DATABASE_URL=postgresql://nascon:nascon@postgres:5432/nascon
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-dev-jwt-secret
JWT_TTL_SECONDS=43200
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=receipts
WEB_CONCURRENCY=2
