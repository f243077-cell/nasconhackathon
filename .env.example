# Copy to .env and fill in. NEVER commit .env.
# Per-team HMAC salt printed on the team slip (required; read only from env).
DAY1_SALT=replace-with-salt-from-team-slip
# Part II salt (16 chars) from the Day 2 venue slip (required; read only from env).
DAY2_SALT=replace-with-day2-salt-from-slip

# Everything below has a working default in docker-compose.yml.
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon
POSTGRES_DB=nascon
DATABASE_URL=postgresql://nascon:nascon@postgres:5432/nascon
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-dev-jwt-secret
JWT_TTL_SECONDS=43200
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=receipts
WEB_CONCURRENCY=4
PUBLIC_BASE_URL=http://localhost:8080
MEDIA_PUBLIC_HOST=localhost
MEDIAMTX_API=http://mediamtx:9997
# Shared secret for POST /internal/media/recorded (header X-Media-Hook-Token). Leave empty to disable the route.
MEDIA_HOOK_TOKEN=
# Selenium Grid image tag (spec uses 4.25.0; 4.24.0 also works if pre-pulled)
SELENIUM_TAG=4.25.0
# Anonymous guest token lifetime in seconds (FR-4.2).
GUEST_TOKEN_TTL_S=14400
